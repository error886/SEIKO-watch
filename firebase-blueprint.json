{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "HomePageConfig": {
      "title": "Home Page Configuration",
      "description": "Settings for home page layout and content",
      "type": "object",
      "properties": {
        "productLimit": { "type": "integer" },
        "productsPerRow": { "type": "integer" },
        "showFeaturedOnly": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Watch product details",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "series": { "type": "string" },
        "price": { "type": "string" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "specs": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "series", "price", "image", "description"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "district": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipping", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "email", "phone", "address", "city", "district", "paymentMethod", "items", "total", "status"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Customer feedback/review testimonial",
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "location": { "type": "string" },
        "rating": { "type": "integer" },
        "model": { "type": "string" }
      },
      "required": ["content", "author", "location", "rating", "model"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Home page banner image settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["image", "title"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "configs/homepage": {
      "schema": "HomePageConfig",
      "description": "Home page layout settings"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of watch products"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders"
    },
    "feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Customer feedback testimonials"
    },
    "banners/{bannerId}": {
      "schema": "Banner",
      "description": "Banners carousel on front-page"
    }
  }
}
